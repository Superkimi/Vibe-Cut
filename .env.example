# Comma-separated HTTPS origins for additional OpenAI-compatible providers.
# Built-in origins include OpenAI, Anthropic, OpenRouter, DeepSeek, Groq,
# Moonshot, and DashScope.
VIBECUT_AI_ALLOWED_ORIGINS=

# Optional deployment mount point, for example https://example.com/vibe-cut/.
NEXT_PUBLIC_BASE_PATH=
